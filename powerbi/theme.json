{
  "name": "Retail Insights",
  "dataColors": [
    "#118DFF",
    "#E66C37",
    "#159E83",
    "#8F5AD9",
    "#B88400",
    "#D9479E",
    "#4F6AE0",
    "#6F9A1F"
  ],
  "foreground": "#252423",
  "foregroundNeutralSecondary": "#605E5C",
  "foregroundNeutralTertiary": "#8A8886",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F2F1",
  "backgroundNeutral": "#E1DFDD",
  "tableAccent": "#118DFF",
  "good": "#107C10",
  "neutral": "#8A8886",
  "bad": "#C4314B",
  "maximum": "#0B4FA0",
  "center": "#BFD9FF",
  "minimum": "#EAF3FF",
  "null": "#C8C6C4",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#605E5C" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1DFDD" } }, "radius": 4 }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": true, "foreground": { "solid": { "color": "#605E5C" } } }],
        "title": [{ "show": true, "fontSize": 12, "fontColor": { "solid": { "color": "#252423" } } }],
        "padding": [{ "top": 12, "bottom": 12, "left": 12, "right": 12 }],
        "valueAxis": [{ "gridlineStyle": "solid", "gridlineColor": { "solid": { "color": "#EDEBE9" } }, "gridlineThickness": 1 }],
        "categoryAxis": [{ "gridlineShow": false }],
        "legend": [{ "show": true, "position": "Top", "fontSize": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F2F1" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F3F2F1" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontSize": 28, "color": { "solid": { "color": "#252423" } } }],
        "categoryLabels": [{ "show": true, "fontSize": 11, "color": { "solid": { "color": "#605E5C" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": false }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#605E5C" } }, "textSize": 10 }],
        "items": [{ "fontColor": { "solid": { "color": "#252423" } }, "textSize": 10 }]
      }
    }
  }
}
